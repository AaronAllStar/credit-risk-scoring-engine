# Configuración de variables de entorno para Credit Risk Scoring Engine
# IMPORTANTE: No almacenar credenciales reales en este archivo; copiar como .env y personalizar.

# Configuración del Servidor HTTP Rust
PORT=3000
HOST=0.0.0.0
RUST_LOG=info

# Configuración de Conexión a Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=credit_risk_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=credit_analytics

# Configuración de Seguridad y CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
